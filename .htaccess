# Apache (Hostinger) — bloque l'accès direct aux fichiers sensibles.

# Bloquer .env et fichiers similaires
<FilesMatch "^\.env|\.env\..*|\.git|composer\.(json|lock)$">
  Require all denied
</FilesMatch>

# Bloquer accès au dossier php/ (utilisé uniquement en include)
RedirectMatch 403 ^/php(/|$)

# Forcer UTF-8
AddDefaultCharset UTF-8

# Sécurité de base
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# MIME types (au cas où non déclarés côté serveur)
<IfModule mod_mime.c>
  AddType image/webp                .webp
  AddType image/avif                .avif
  AddType font/woff2                .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Cache des assets statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                       "access plus 1 month"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/avif             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/gif              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 month"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript        "access plus 1 month"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType text/html              "access plus 1 hour"
</IfModule>

# Cache-Control immutable pour les ressources réellement statiques (images, fonts)
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # CSS/JS : long cache mais sans immutable (au cas où on push une correction)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML : revalidation rapide
  <FilesMatch "\.(html|webmanifest|xml)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# Compression — Brotli si dispo, sinon Gzip (fallback)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json font/woff2
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# Pages erreur
ErrorDocument 404 /index.html
