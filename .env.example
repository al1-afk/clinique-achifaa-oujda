# =====================================================
# Clinique Achifaa Oujda — Configuration SMTP
# Copier ce fichier vers .env et remplir les valeurs réelles.
# Le fichier .env ne doit JAMAIS être committé sur Git (cf .gitignore)
# =====================================================

# SMTP — Hostinger Business Email
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@cliniqueachifaaoujda.com
SMTP_PASSWORD=

# Destinataire des demandes de RDV (généralement = SMTP_USER)
MAIL_TO=info@cliniqueachifaaoujda.com

# Nom affiché dans l'en-tête From
MAIL_FROM_NAME=Site Clinique Achifaa Oujda

# URL absolue du site (utilisée pour les redirections après envoi)
SITE_URL=https://cliniqueachifaaoujda.com

# Sujet par défaut
MAIL_SUBJECT=Nouvelle demande de RDV — Clinique Achifaa Oujda
